{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "meta/site"
  ],
  "scripts": {
    "build": "vp run build -r",
    "setup": "bun tools/setup/index.ts",
    "dev": "bun install --silent && bun run --cwd apps/web vite dev",
    "deploy": "npx wrangler deploy",
    "db:auth": "bun run --cwd packages/auth db:auth",
    "db:generate": "bun run --cwd packages/db db:generate && bun db:migrate",
    "db:migrate": "npx wrangler d1 migrations apply db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply db --remote",
    "db:studio": "bun run --cwd packages/db db:studio",
    "dev:email": "vp run @ingot/email#dev",
    "e2e": "bun run --cwd apps/e2e e2e",
    "e2e:ui": "bun run --cwd apps/e2e e2e:ui",
    "wrangler-types": "bunx --bun wrangler types apps/web/worker-configuration.d.ts",
    "ok": "syncpack fix --config .syncpackrc --log-levels error && bun run wrangler-types && vp run ts -r && vp fmt --write && vp lint --fix && bun test",
    "ok:ci": "syncpack lint --config .syncpackrc --log-levels error && bun run wrangler-types && vp run ts -r && vp fmt --check && vp lint && bun test",
    "knip": "knip -c knip.json",
    "ok:full": "bun knip && bun ok && bun e2e",
    "clean": "bun run --filter '*' clean",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260330.1",
    "knip": "6.1.0",
    "syncpack": "14.3.0",
    "typescript": "catalog:",
    "ultracite": "7.4.0",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.10",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "0.1.14",
    "typescript": "6.0.2",
    "@types/node": "25.5.0",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6",
    "better-auth": "1.5.6",
    "@better-auth/passkey": "1.5.6",
    "drizzle-orm": "0.45.2",
    "tailwindcss": "4.2.2",
    "lucide-react": "1.7.0",
    "sonner": "2.0.7",
    "@lingui/core": "5.9.4",
    "@lingui/react": "5.9.4",
    "@lingui/cli": "5.9.4",
    "@lingui/vite-plugin": "5.9.4",
    "@lingui/babel-plugin-lingui-macro": "5.9.4",
    "babel-plugin-macros": "3.1.0",
    "@orpc/server": "1.13.13",
    "@tanstack/react-router": "1.168.8",
    "@tanstack/router-plugin": "1.167.10",
    "@vitejs/plugin-react": "6.0.1"
  },
  "lingui": {
    "locales": [
      "en"
    ],
    "sourceLocale": "en",
    "compileNamespace": "es",
    "catalogs": [
      {
        "path": "<rootDir>/apps/web/src/locales/{locale}/messages",
        "include": [
          "apps/web/src/**/*.{ts,tsx}"
        ]
      },
      {
        "path": "<rootDir>/packages/email/locales/{locale}/messages",
        "include": [
          "packages/email/**/*.{ts,tsx}"
        ],
        "exclude": [
          "**/node_modules/**",
          "**/locales/**"
        ]
      }
    ]
  }
}
