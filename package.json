{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "vp run build -r",
    "setup": "bun meta/cast/setup.ts",
    "dev": "bun install --silent && bun run --cwd apps/web vite dev",
    "deploy": "npx wrangler deploy",
    "db:auth": "bun run --cwd packages/auth db:auth",
    "db:generate": "bun run --cwd packages/db db:generate && bun db:migrate",
    "db:migrate": "npx wrangler d1 migrations apply db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply db --remote",
    "db:studio": "bun run --cwd packages/db db:studio",
    "dev:email": "vp run @ingot/email#dev",
    "e2e": "bun run --cwd apps/e2e e2e",
    "e2e:ui": "bun run --cwd apps/e2e e2e:ui",
    "ok": "syncpack fix --config _etc/.syncpackrc --log-levels error && vp run ts -r && vp fmt --write && vp lint --fix && bun test",
    "ok:ci": "syncpack lint --config _etc/.syncpackrc --log-levels error && vp run ts -r && vp fmt --check && vp lint && bun test",
    "knip": "knip -c _etc/knip.json",
    "ok:full": "bun knip && bun ok && bun e2e",
    "clean": "bun run --filter '*' clean",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260317.1",
    "knip": "5.87.0",
    "syncpack": "14.2.0",
    "typescript": "catalog:",
    "ultracite": "7.3.1",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.10",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "0.1.12",
    "typescript": "5.9.3",
    "@types/node": "22.19.7",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.3.6",
    "better-auth": "1.5.5",
    "@better-auth/passkey": "1.5.5",
    "drizzle-orm": "0.45.1",
    "tailwindcss": "4.1.18",
    "lucide-react": "0.577.0",
    "sonner": "2.0.7",
    "@lingui/core": "5.9.3",
    "@lingui/react": "5.9.3",
    "@lingui/cli": "5.9.3",
    "@lingui/vite-plugin": "5.9.3",
    "@lingui/babel-plugin-lingui-macro": "5.9.3",
    "babel-plugin-macros": "3.1.0"
  },
  "lingui": {
    "locales": [
      "en"
    ],
    "sourceLocale": "en",
    "compileNamespace": "es",
    "catalogs": [
      {
        "path": "<rootDir>/apps/web/src/_etc/locales/{locale}/messages",
        "include": [
          "apps/web/src/**/*.{ts,tsx}"
        ]
      },
      {
        "path": "<rootDir>/packages/email/_etc/locales/{locale}/messages",
        "include": [
          "packages/email/**/*.{ts,tsx}"
        ],
        "exclude": [
          "**/node_modules/**",
          "**/_etc/locales/**"
        ]
      }
    ]
  }
}
