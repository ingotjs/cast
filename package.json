{
	"name": "start",
	"version": "0.0.0",
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@socketsecurity/bun-security-scanner": "1.1.2",
		"@typescript/native-preview": "7.0.0-dev.20260315.1",
		"syncpack": "14.2.0",
		"turbo": "2.8.17",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.9",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "bunx biome check --write --unsafe . --error-on-warnings",
		"lint:ci": "bunx biome check . --error-on-warnings",
		"ok": "bun syncpack:auto && bun ts && bun lint",
		"ok:ci": "bun syncpack:auto && bun ts && bun lint:ci",
		"syncpack:auto": "if [ -n \"$CI\" ]; then syncpack lint; else syncpack fix; fi",
		"syncpack:fix": "syncpack fix",
		"syncpack:lint": "syncpack lint",
		"ts": "turbo --output-logs=errors-only ts"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
