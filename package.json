{
	"name": "start",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "bunx biome check --write --unsafe . --error-on-warnings",
		"lint:ci": "bunx biome check . --error-on-warnings",
		"ts": "turbo --output-logs=errors-only ts",
		"ok": "bun ts && bun lint",
		"ok:ci": "bun ts && bun lint:ci"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@typescript/native-preview": "^7.0.0-dev.20260315.1",
		"turbo": "^2.8.17",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.9",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
