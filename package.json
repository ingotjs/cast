{
  "name": "start",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo --output-logs=errors-only build",
    "dev": "bun install --silent && turbo dev",
    "db:studio": "bun run --cwd packages/server db:studio",
    "db:generate": "bun run --cwd packages/server db:generate",
    "db:migrate": "bun run --cwd packages/server db:migrate",
    "dev:email": "turbo dev --filter @packages/email",
    "ok": "syncpack fix --log-levels error && bun ts && ultracite fix && turbo --output-logs=errors-only test",
    "ok:ci": "syncpack lint --log-levels error && bun ts && ultracite check && turbo --output-logs=errors-only test",
    "ts": "turbo --output-logs=errors-only ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260315.1",
    "husky": "9.1.7",
    "oxfmt": "0.40.0",
    "oxlint": "1.55.0",
    "syncpack": "14.2.0",
    "turbo": "2.8.17",
    "typescript": "5.9.3",
    "ultracite": "7.3.1"
  },
  "packageManager": "bun@1.3.10"
}
