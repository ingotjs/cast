{
  "name": "start",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "bun install --silent && turbo dev",
    "db:auth": "bun run --cwd packages/server db:auth",
    "db:generate": "bun run --cwd packages/server db:generate",
    "db:migrate": "cd apps/web && npx wrangler d1 migrations apply omegastart-db --local",
    "db:migrate:remote": "cd apps/web && npx wrangler d1 migrations apply omegastart-db --remote",
    "db:studio": "bun run --cwd packages/server db:studio",
    "dev:email": "turbo dev --filter @packages/email",
    "e2e": "bun run --cwd apps/e2e e2e",
    "e2e:ui": "bun run --cwd apps/e2e e2e:ui",
    "ok": "syncpack fix --log-levels error && bun ts && ultracite fix && turbo test",
    "ok:ci": "syncpack lint --log-levels error && bun ts && ultracite check && turbo test",
    "ts": "turbo ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "husky": "9.1.7",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "syncpack": "14.2.0",
    "turbo": "2.8.17",
    "typescript": "5.9.3",
    "ultracite": "7.3.1"
  },
  "packageManager": "bun@1.3.10"
}
