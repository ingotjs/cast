# Service env vars — set to enable, leave empty to disable
# Reference: https://posthog.com
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=https://us.posthog.com  # US Cloud (default). Use https://eu.posthog.com for EU data residency.

# Reference: https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=

# Reference: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Production only
# DATABASE_URL=
# BETTER_AUTH_SECRET=  # Generate with: openssl rand -base64 32
