# Service env vars — set to enable, leave empty to disable
# Reference: https://posthog.com
# VITE_PUBLIC_POSTHOG_KEY=
# VITE_PUBLIC_POSTHOG_HOST=  # Defaults to https://us.posthog.com. Set to https://eu.posthog.com for EU data residency.

# Reference: https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=

# Reference: https://console.cloud.google.com/apis/credentials
# VITE_PUBLIC_GOOGLE_OAUTH=true  # Set to show Google sign-in button
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic link sign-in (requires email env vars above)
# VITE_PUBLIC_MAGIC_LINK=true

# Production only (set via `wrangler secret put` or Cloudflare dashboard)
# DATABASE_URL=               # Neon connection string (e.g. postgresql://user:pass@host/db?sslmode=require)
# BETTER_AUTH_SECRET=         # Generate with: openssl rand -base64 32
# URL=                        # Production URL (e.g. https://myapp.example.com)

# CI only (GitHub Actions secrets)
# CLOUDFLARE_API_TOKEN=       # For wrangler deploy
# POSTHOG_PROJECT_ID=         # For source map upload
# POSTHOG_CLI_API_KEY=        # Personal API key with "error tracking write" + "organization read" scopes
# POSTHOG_PROJECT_API_KEY=    # Same as VITE_PUBLIC_POSTHOG_KEY — for CI metrics reporting
