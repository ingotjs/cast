{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreFiles": [".agents/**", ".claude/**", "**/_etc/tests/**"],
  "ignoreIssues": {
    "**/_etc/locales/**": ["exports"],
    "apps/e2e/coverage.ts": ["exports"],
    "bunfig.toml": ["unresolved"]
  },
  "exclude": ["duplicates"],
  "workspaces": {
    ".": {
      "entry": ["vite.config.ts"],
      "ignoreDependencies": ["@lingui/cli", "@socketsecurity/bun-security-scanner", "ultracite", "@ingot/config"],
      "ignoreBinaries": ["wrangler"]
    },
    "apps/web": {
      "entry": [
        "vite.config.ts",
        "src/server.ts",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/lib/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": { "config": [] },
      "ignoreDependencies": [
        "@tanstack/react-query",
        "@tanstack/react-router-ssr-query",
        "@tanstack/router-plugin",
        "tailwindcss",
        "@tailwindcss/typography",
        "babel-plugin-react-compiler",
        "cloudflare"
      ],
      "ignoreBinaries": ["vite"]
    },
    "apps/e2e": {},
    "packages/api": {},
    "packages/auth": {
      "entry": ["i18n.ts"],
      "ignoreDependencies": ["@simplewebauthn/server"]
    },
    "packages/config": {
      "entry": ["*.json"]
    },
    "packages/db": {},
    "packages/email": {
      "entry": ["lingui.config.ts", "locale.ts"],
      "ignoreDependencies": ["@react-email/tailwind", "react-dom", "@react-email/preview-server", "@types/react-dom"]
    },
    "packages/ui": {
      "ignore": ["svgs/omega-icon.tsx"],
      "ignoreDependencies": ["postcss-load-config"]
    },
    "packages/utils": {},
    "packages/prospect": {},
    "meta/cast": {
      "entry": ["bin.ts"]
    }
  }
}
