{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": "bun db:migrate",
    "startCommand": "bun run --cwd apps/web start",
    "healthcheckPath": "/api/auth/ok",
    "healthcheckTimeout": 100,
    "restartPolicyType": "on_failure"
  }
}
