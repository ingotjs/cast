{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream-with-experimental-timestamps",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "ts": {
      "dependsOn": ["^ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
