{
  "name": "@ingot/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./email-capture": "./email-capture.ts",
    "./emails/*": "./emails/*.tsx",
    "./send": "./send.ts",
    "./templates": "./templates.ts"
  },
  "scripts": {
    "dev:email": "email dev --port 3002",
    "build": "lingui compile --config lingui.config.ts",
    "build:email": "email build",
    "clean": "rm -rf .react-email .email-captures locales/*/messages.ts",
    "export": "email export",
    "ts": "tsgo --noEmit"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@react-email/components": "1.0.10",
    "@react-email/tailwind": "2.0.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "6.10.0"
  },
  "devDependencies": {
    "@ingot/config": "*",
    "@ingot/utils": "*",
    "@lingui/cli": "catalog:",
    "@react-email/preview-server": "5.2.10",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-email": "5.2.10",
    "typescript": "catalog:"
  }
}
