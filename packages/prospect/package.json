{
  "name": "@ingot/prospect",
  "version": "0.0.0",
  "description": "The full Playwright companion — coverage, flakiness, artifacts, and a dev overlay",
  "keywords": [
    "artifacts",
    "coverage",
    "e2e",
    "flakiness",
    "ingot",
    "overlay",
    "playwright",
    "prospect",
    "reporter",
    "tanstack-intent",
    "test-coverage",
    "testing",
    "visual-regression"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": "./define-coverage.ts",
    "./setup": "./setup.ts",
    "./overlay": "./overlay/coverage-overlay.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./setup": "./dist/setup.mjs",
      "./overlay": "./dist/overlay.mjs"
    }
  },
  "scripts": {
    "ts": "tsgo --noEmit",
    "prepublishOnly": "vp pack define-coverage.ts setup.ts overlay/coverage-overlay.tsx"
  },
  "devDependencies": {
    "@ingot/config": "*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
